{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/documents/[id]/stream/route.ts": {
      "maxDuration": 900,
      "supportsCancellation": true
    },
    "app/api/documents/[id]/process/route.ts": {
      "maxDuration": 900
    },
    "app/api/documents/[id]/export/route.ts": {
      "maxDuration": 300
    }
  }
}
