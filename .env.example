# Neon PostgreSQL connection string (pooled).
DATABASE_URL=

# Vercel Blob read/write token for temporary document storage.
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway key used by the detection/analysis tasks.
AI_GATEWAY_API_KEY=

# Model id resolved through the AI Gateway, e.g. "anthropic/claude-haiku-4-5".
AI_MODEL=

# Base64 32-byte master key. Per-document AES-256-GCM data keys are wrapped with it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Server-only secret used to hash the anonymous abuse-prevention identifier.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINGERPRINT_SECRET=

# Secret Vercel sends with scheduled cron invocations, so the expiry sweep
# cannot be triggered from outside.
CRON_SECRET=

# Optional. USD per million tokens for the configured model, used to turn the
# recorded token counts into an estimated cost. Prices differ per account and
# change often, so they are supplied here rather than hardcoded — leave these
# unset and the UI reports tokens and duration without a currency figure.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
