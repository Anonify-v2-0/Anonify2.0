# Anonify configuration.
#
# Run `pnpm setup` to generate a working .env, or copy this file to .env and
# fill it in by hand. Every variable is listed here, so nothing has to be
# discovered from a stack trace.
#
# `pnpm setup` walks through the limits at the bottom of this file as well as
# the services at the top — daily quotas, rate limits, email parser limits and
# attachment expansion — showing each default as read from the code that
# enforces it. `pnpm setup --help` lists the flags for a scripted install.

# ---- Deployment profile ----------------------------------------------------
# Who can reach this instance, which is a different question from which
# services it uses: a self-hosted install on Neon is still your install and
# gets your allowances. It chooses the defaults for every limit below.
#
# "self-hosted" (default) — generous rate limits, no daily quotas at all. Your
#                           machine, your rules.
# "demo"                  — restrictive limits and small daily allowances, for a
#                           shared public deployment where one visitor's
#                           spreadsheet is everyone's budget.
ANONIFY_PROFILE=self-hosted

# ---- Database --------------------------------------------------------------
# Local Postgres (docker compose):
#   postgresql://anonify:anonify@localhost:5432/anonify
# Neon: the pooled connection string from the dashboard.
DATABASE_URL=

# Database for the integration suites (`pnpm test:db`). These create and delete
# rows, so this must never be DATABASE_URL — point it at a throwaway database:
#   postgresql://anonify:anonify@localhost:5432/anonify_test
# Unset means the database-backed suites skip, and `pnpm test` still passes.
TEST_DATABASE_URL=

# "postgres" or "neon". Inferred from the connection string when unset — Neon
# hostnames are recognisable — so this is only needed to override a bad guess.
DATABASE_DRIVER=

# ---- Workflow --------------------------------------------------------------
# The durable pipeline needs a world to keep runs, steps and streams in. On
# Vercel that backend is provided by the platform and these stay unset.
# Anywhere else — a container, a VM — name the Postgres world here so
# instrumentation.ts starts the worker that polls for jobs. Without it a
# self-hosted install accepts uploads and never processes them.
#
# The package that provides the world; `require()`d dynamically in
# instrumentation.ts, so naming it here is also what puts the package and its
# Postgres driver into the standalone build's traced dependencies.
WORKFLOW_TARGET_WORLD=
# The Postgres world reads this, not DATABASE_URL. When unset it silently falls
# back to postgres://world:world@localhost:5432/world, which on a self-hosted
# install means a worker that connects to nothing — so instrumentation.ts
# defaults it from DATABASE_URL when this is empty. One connection string
# usually configures both.
WORKFLOW_POSTGRES_URL=

# ---- Object storage --------------------------------------------------------
# "s3" (MinIO or AWS), "vercel-blob", or "local" (filesystem, no setup at all).
# Inferred from what is configured when unset.
STORAGE_DRIVER=

# Vercel Blob. With this set, the browser uploads directly to Blob storage.
BLOB_READ_WRITE_TOKEN=

# S3-compatible storage. MinIO from docker compose uses the values below.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=anonify
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO needs path-style addressing; AWS does not. Inferred from S3_ENDPOINT.
S3_FORCE_PATH_STYLE=

# ---- OCR -------------------------------------------------------------------
# "tesseract" (default) runs locally with no account and gives per-word boxes.
# "mistral" reads difficult scans better but locates text per paragraph, so a
# redaction covers the whole block rather than the exact characters.
OCR_PROVIDER=tesseract

# Required when OCR_PROVIDER=mistral. https://console.mistral.ai
MISTRAL_API_KEY=

# ---- OCR models ------------------------------------------------------------
# Which model each engine reads with. Every value below is checked against a
# fixed list when it is read, so a typo is an error naming the valid values
# rather than a 404 from a CDN in the middle of somebody's first scanned page.

# Tesseract's model size. One of:
#   fast      ~2 MB per language. Quickest, least accurate on poor scans.
#   standard  ~3 MB. The balance tesseract.js ships with, and the default.
#   best      ~13 MB. Float model — slowest, best on difficult scans.
# Each variant caches in its own directory, so switching actually switches.
OCR_TESSERACT_MODEL=standard

# The language Tesseract reads. One or more of:
#   eng deu fra spa ita por nld pol rus tur ara hin jpn kor chi_sim
# Join several with +, as in eng+deu; the first is primary. Only languages
# present in all three model variants are listed, so changing the variant can
# never leave you without the data for the language you chose.
#
# Note that detection is still English-shaped (see issue #43): this makes the
# page readable, which is the half that has to work first.
OCR_TESSERACT_LANGUAGE=eng

# Mistral's OCR model. One of: mistral-ocr-latest, mistral-ocr-2505.
# `latest` follows their newest release, which is the right default here — a
# better reader is strictly better and there is no output format to break.
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Where Tesseract caches its language model. Defaults to .cache/tesseract
# (gitignored), with a subdirectory per model variant. Point this at a mounted
# volume if you run the app in a container, so the download survives a restart.
# `pnpm ocr:warm` fetches what is configured, up front.
TESSERACT_CACHE_PATH=

# ---- AI detection ----------------------------------------------------------
# Optional. Without it the contextual pass is skipped and pattern detection,
# manual redaction, global rules and export all still work.
AI_GATEWAY_API_KEY=

# Optional; defaults to a small fast vision-capable model.
AI_MODEL=

# Optional. USD per million tokens, used to turn recorded token counts into an
# estimated cost. Prices change and differ per account, so they are not
# hardcoded — leave unset and the UI reports tokens and duration only.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# ---- External service limits -----------------------------------------------
# The opposite direction from ANONIFY_RATE_LIMIT_* above. Those ration callers
# arriving here; these pace this instance arriving somewhere else, where being
# refused does not produce a tidy 429 — it costs a page of somebody's document.
#
# Two mechanisms, and they are not the same thing. Pacing holds a request back
# until the bucket can afford it, so a limit you know about is never hit.
# Retrying handles the one you did not: a 429, a 5xx or a timeout is tried
# again with jitter, honouring Retry-After; a 401, 402 or 403 is not retried at
# all, because no number of tries fixes a bad key or an empty balance.
#
# Unlike every other limit here these are not per-profile, because they describe
# somebody else's service: an account's ceiling is the same whether a demo or a
# laptop is calling it. Defaults live in lib/services/limits.ts.

# The AI Gateway. Concurrency is process-wide rather than per document — six
# documents at four calls each was twenty-four concurrent calls and a ceiling
# nobody chose. The rate is 0 (unpaced) by default because the gateway meters
# spend, not requests; set one if the provider behind yours has a known RPM.
ANONIFY_AI_CONCURRENCY=4
ANONIFY_AI_REQUESTS_PER_MINUTE=0
ANONIFY_AI_MAX_ATTEMPTS=4

# Hosted OCR. Applies only to a provider that is not local — Tesseract runs on
# your machine and answers to no limit. Mistral's free tier is roughly one
# request a second, which is what 60 a minute keeps you under.
ANONIFY_OCR_CONCURRENCY=2
ANONIFY_OCR_REQUESTS_PER_MINUTE=60
ANONIFY_OCR_MAX_ATTEMPTS=4

# The gateway's real ceiling: USD per UTC day, estimated from the prices above
# and the token counts already recorded on every call. 0 is no cap, which is the
# default — a budget nobody set must never silently stop a redaction.
#
# At 80% the gateway drops to one call at a time. At 100% the contextual pass is
# skipped for the rest of the day, exactly as an install with no key behaves:
# pattern detection, manual redaction, rules and export all still work, and the
# document says so rather than looking finished.
#
# Needs AI_PRICE_* set. Without them no spend can be estimated, and the app says
# so in the log rather than pretending to enforce a cap it cannot compute.
ANONIFY_AI_DAILY_SPEND_USD=0

# ---- Secrets ---------------------------------------------------------------
# Both must decode to 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Master key for per-document AES-256-GCM envelope encryption.
# Losing this makes every stored document unreadable.
ENCRYPTION_KEY=

# Salts the anonymous identity and signs download links.
FINGERPRINT_SECRET=

# ---- Scheduled cleanup -----------------------------------------------------
# Gates the expiry sweep so it cannot be triggered from outside. On Vercel this
# is sent automatically with cron invocations. Set it for any deployment that is
# reachable from the internet.
CRON_SECRET=

# Used by the `scheduler` compose service, which calls the cleanup endpoint on a
# timer. vercel.json's cron entry is read by Vercel and nothing else, so a
# self-hosted install needs its own scheduler — or `pnpm cleanup` from cron.
#   docker compose --profile scheduler up -d
# The app's address as seen from the scheduler container. Use
# http://host.docker.internal:3000 instead if you run the app on the host.
ANONIFY_URL=http://app:3000
CLEANUP_INTERVAL_SECONDS=900

# ---- Docker Compose --------------------------------------------------------
# Host ports for `docker compose up`. Change these if something on your machine
# already listens on them; the addresses used inside the compose network are
# fixed and unaffected.
APP_PORT=3000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Rate limits -----------------------------------------------------------
# Optional overrides, as "requests/seconds". These beat the profile defaults;
# `pnpm rate-limit set` beats these and takes effect without a restart.
#   ANONIFY_RATE_LIMIT_UPLOAD=100/60
#   ANONIFY_RATE_LIMIT_PROCESSING=300/60
#   ANONIFY_RATE_LIMIT_EXPORT=100/60
#   ANONIFY_RATE_LIMIT_READ=2000/60

# ---- Batch size and concurrency --------------------------------------------
# How much happens at once, which is a different question from how often it may
# start. A rate limit refills while work is still running, so it bounds the
# arrival of work and not the amount of it in flight; these bound the amount.
# Together they are what keeps memory, database connections and model spend
# from being a function of how many files somebody happened to drag in.
#
# A document waiting for a processing slot shows as queued and starts on its
# own when one frees up — nothing is refused for being third in line.
#
# Defaults are per profile: 20/3/2 for a shared demo, 50/6/4 self-hosted.
#   ANONIFY_BATCH_MAX_FILES=20    # documents in one batch
#   ANONIFY_BATCH_PROCESSING=3    # your documents processing at once
#   ANONIFY_BATCH_EXPORTING=2     # documents exported at once, within one batch

# ---- Email parser limits ---------------------------------------------------
# An email is the one format here that arrives from strangers by design, and
# MIME is a recursive container with no natural bound. These cap what one
# message may cost, independently of the upload size — raising the upload
# ceiling must not mean unlimited MIME complexity. Exceeding one is a refusal
# with a reason, never a truncated document presented as a complete one.
#   ANONIFY_EML_MAX_DEPTH=20             # multipart nesting
#   ANONIFY_EML_MAX_PARTS=1000           # parts across the whole tree
#   ANONIFY_EML_MAX_TEXT_BYTES=16777216  # decoded text, all parts and nesting
#   ANONIFY_EML_MAX_HEADER_BYTES=1048576 # one part's header block
#   ANONIFY_EML_MAX_ATTACHMENTS=200
#   ANONIFY_EML_MAX_NESTED_MESSAGES=5    # message/rfc822 inside one another
#
# A message that carries attachments in supported formats is expanded into a
# batch: the message is one document and each attachment is another, with its
# own run, its own quota accounting and its own export. That is a different
# cost with a different amplification factor from parsing, so it has its own
# limits, in the same fail-closed style. The child count deliberately matches
# the ceiling on a batch a person can upload — a message must not be a way to
# create a larger batch than the upload panel will.
#   ANONIFY_EML_EXPANSION_MAX_CHILDREN=20
#   ANONIFY_EML_EXPANSION_MAX_EXPANDED_BYTES=67108864   # across all of them
#   ANONIFY_EML_EXPANSION_MAX_ATTACHMENT_BYTES=26214400 # any single one
#   ANONIFY_EML_EXPANSION_MAX_DEPTH=3                   # a message in a message

# ---- Daily quotas ----------------------------------------------------------
# Per identity, per UTC day. Unset means the profile default, which for a
# self-hosted install is unlimited. 0 is also unlimited.
#   ANONIFY_QUOTA_PDF_PAGES=200
#   ANONIFY_QUOTA_DOCX_PAGES=200
#   ANONIFY_QUOTA_XLSX_CELLS=500000
#   ANONIFY_QUOTA_IMAGES=100
#   ANONIFY_QUOTA_TEXT_PAGES=400
#   ANONIFY_QUOTA_EMAIL_KILOBYTES=4096
#   ANONIFY_QUOTA_PPTX_SLIDES=200
#   ANONIFY_QUOTA_UPLOADS=200
#
# The units, since they are not all the same shape:
#   PDF_PAGES / DOCX_PAGES  pages of a paginated document
#   XLSX_CELLS              filled cells, in a workbook, a CSV or a TSV — blank
#                           cells are neither work to process nor a leak
#   TEXT_PAGES              pages of extracted text, for .txt and .rtf
#   EMAIL_KILOBYTES         KiB of decoded text pulled out of a message:
#                           headers, every body, every nested message
#   PPTX_SLIDES             slides; notes, layouts and masters are processed
#                           with the slide they belong to
#   IMAGES / UPLOADS        one each
