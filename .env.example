# Anonify configuration.
#
# Run `pnpm setup` to generate a working .env for either setup, or copy this
# file to .env and fill it in by hand. Every variable is listed here, so nothing
# has to be discovered from a stack trace.

# ---- Deployment profile ----------------------------------------------------
# "self-hosted" (default) — generous rate limits, no daily quotas at all. Your
#                           machine, your rules.
# "demo"                  — restrictive limits and small daily allowances, for a
#                           shared public deployment where one visitor's
#                           spreadsheet is everyone's budget.
ANONIFY_PROFILE=self-hosted

# ---- Database --------------------------------------------------------------
# Local Postgres (docker compose):
#   postgresql://anonify:anonify@localhost:5432/anonify
# Neon: the pooled connection string from the dashboard.
DATABASE_URL=

# Database for the integration suites (`pnpm test:db`). These create and delete
# rows, so this must never be DATABASE_URL — point it at a throwaway database:
#   postgresql://anonify:anonify@localhost:5432/anonify_test
# Unset means the database-backed suites skip, and `pnpm test` still passes.
TEST_DATABASE_URL=

# "postgres" or "neon". Inferred from the connection string when unset — Neon
# hostnames are recognisable — so this is only needed to override a bad guess.
DATABASE_DRIVER=

# ---- Object storage --------------------------------------------------------
# "s3" (MinIO or AWS), "vercel-blob", or "local" (filesystem, no setup at all).
# Inferred from what is configured when unset.
STORAGE_DRIVER=

# Vercel Blob. With this set, the browser uploads directly to Blob storage.
BLOB_READ_WRITE_TOKEN=

# S3-compatible storage. MinIO from docker compose uses the values below.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=anonify
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO needs path-style addressing; AWS does not. Inferred from S3_ENDPOINT.
S3_FORCE_PATH_STYLE=

# ---- OCR -------------------------------------------------------------------
# "tesseract" (default) runs locally with no account and gives per-word boxes.
# "mistral" reads difficult scans better but locates text per paragraph, so a
# redaction covers the whole block rather than the exact characters.
OCR_PROVIDER=tesseract

# Required when OCR_PROVIDER=mistral. https://console.mistral.ai
MISTRAL_API_KEY=

# Where Tesseract caches its ~5 MB language model. Defaults to .cache/tesseract
# (gitignored). Point this at a mounted volume if you run the app in a container,
# so the download survives a restart. `pnpm ocr:warm` fetches it up front.
TESSERACT_CACHE_PATH=

# ---- AI detection ----------------------------------------------------------
# Optional. Without it the contextual pass is skipped and pattern detection,
# manual redaction, global rules and export all still work.
AI_GATEWAY_API_KEY=

# Optional; defaults to a small fast vision-capable model.
AI_MODEL=

# Optional. USD per million tokens, used to turn recorded token counts into an
# estimated cost. Prices change and differ per account, so they are not
# hardcoded — leave unset and the UI reports tokens and duration only.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# ---- Secrets ---------------------------------------------------------------
# Both must decode to 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Master key for per-document AES-256-GCM envelope encryption.
# Losing this makes every stored document unreadable.
ENCRYPTION_KEY=

# Salts the anonymous identity and signs download links.
FINGERPRINT_SECRET=

# ---- Scheduled cleanup -----------------------------------------------------
# Gates the expiry sweep so it cannot be triggered from outside. On Vercel this
# is sent automatically with cron invocations. Set it for any deployment that is
# reachable from the internet.
CRON_SECRET=

# Used by the `scheduler` compose service, which calls the cleanup endpoint on a
# timer. vercel.json's cron entry is read by Vercel and nothing else, so a
# self-hosted install needs its own scheduler — or `pnpm cleanup` from cron.
#   docker compose --profile scheduler up -d
# The app's address as seen from the scheduler container. Use
# http://host.docker.internal:3000 instead if you run the app on the host.
ANONIFY_URL=http://app:3000
CLEANUP_INTERVAL_SECONDS=900

# ---- Docker Compose --------------------------------------------------------
# Host ports for `docker compose up`. Change these if something on your machine
# already listens on them; the addresses used inside the compose network are
# fixed and unaffected.
APP_PORT=3000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Rate limits -----------------------------------------------------------
# Optional overrides, as "requests/seconds". These beat the profile defaults;
# `pnpm rate-limit set` beats these and takes effect without a restart.
#   ANONIFY_RATE_LIMIT_UPLOAD=100/60
#   ANONIFY_RATE_LIMIT_PROCESSING=300/60
#   ANONIFY_RATE_LIMIT_EXPORT=100/60
#   ANONIFY_RATE_LIMIT_READ=2000/60

# ---- Email parser limits ---------------------------------------------------
# An email is the one format here that arrives from strangers by design, and
# MIME is a recursive container with no natural bound. These cap what one
# message may cost, independently of the upload size — raising the upload
# ceiling must not mean unlimited MIME complexity. Exceeding one is a refusal
# with a reason, never a truncated document presented as a complete one.
#   ANONIFY_EML_MAX_DEPTH=20             # multipart nesting
#   ANONIFY_EML_MAX_PARTS=1000           # parts across the whole tree
#   ANONIFY_EML_MAX_TEXT_BYTES=16777216  # decoded text, all parts and nesting
#   ANONIFY_EML_MAX_HEADER_BYTES=1048576 # one part's header block
#   ANONIFY_EML_MAX_ATTACHMENTS=200
#   ANONIFY_EML_MAX_NESTED_MESSAGES=5    # message/rfc822 inside one another

# ---- Daily quotas ----------------------------------------------------------
# Per identity, per UTC day. Unset means the profile default, which for a
# self-hosted install is unlimited. 0 is also unlimited.
#   ANONIFY_QUOTA_PDF_PAGES=200
#   ANONIFY_QUOTA_DOCX_PAGES=200
#   ANONIFY_QUOTA_XLSX_CELLS=500000
#   ANONIFY_QUOTA_IMAGES=100
#   ANONIFY_QUOTA_TEXT_PAGES=400
#   ANONIFY_QUOTA_EMAIL_KILOBYTES=4096
#   ANONIFY_QUOTA_PPTX_SLIDES=200
#   ANONIFY_QUOTA_UPLOADS=200
#
# The units, since they are not all the same shape:
#   PDF_PAGES / DOCX_PAGES  pages of a paginated document
#   XLSX_CELLS              filled cells, in a workbook, a CSV or a TSV — blank
#                           cells are neither work to process nor a leak
#   TEXT_PAGES              pages of extracted text, for .txt and .rtf
#   EMAIL_KILOBYTES         KiB of decoded text pulled out of a message:
#                           headers, every body, every nested message
#   PPTX_SLIDES             slides; notes, layouts and masters are processed
#                           with the slide they belong to
#   IMAGES / UPLOADS        one each
