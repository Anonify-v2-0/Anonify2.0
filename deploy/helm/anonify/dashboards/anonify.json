{
  "title": "Anonify",
  "uid": "anonify",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "anonify"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(anonify_build_info, namespace)",
        "refresh": 2,
        "label": "Namespace"
      },
      {
        "name": "release",
        "type": "textbox",
        "query": "anonify",
        "label": "Release name"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue: jobs ready and running",
      "description": "What workers scale on. Read from Postgres, so every pod reports the same number.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (anonify_queue_jobs_ready{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "ready {{queue}}"
        },
        {
          "refId": "B",
          "expr": "max by (queue) (anonify_queue_jobs_locked{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "running {{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest ready job",
      "description": "How long the oldest job has waited for a worker. Rising: add workers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (anonify_queue_oldest_ready_seconds{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Documents by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (anonify_documents_by_status{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Step duration p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, step) (rate(anonify_step_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$release-.*\"}[5m])))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU slots",
      "description": "Work waiting for a slot means the pod is CPU-bound.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (anonify_cpu_slots_in_use{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "in use {{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (anonify_cpu_slots_waiting{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "waiting {{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Event loop p99",
      "description": "Under 50ms is the target (#194). Above a second, probes start to time out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (nodejs_eventloop_lag_p99_seconds{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Step retries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (step) (rate(anonify_step_retries_total{namespace=\"$namespace\", pod=~\"$release-.*\"}[5m]))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database pool",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (anonify_db_pool_total{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "open {{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (anonify_db_pool_waiting{namespace=\"$namespace\", pod=~\"$release-.*\"})",
          "legendFormat": "waiting {{pod}}"
        }
      ]
    }
  ]
}
