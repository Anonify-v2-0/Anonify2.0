generator client {
  provider = "prisma-client"
  output   = "../lib/database/generated"
}

datasource db {
  provider = "postgresql"
}

/// An uploaded source document. The stored source bytes are AES-256-GCM
/// encrypted; `checksum` is a SHA-256 integrity hash, never a key.
model Document {
  id               String   @id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  expiresAt        DateTime
  ttlSeconds       Int      @default(86400)

  originalName     String
  kind             String
  mimeType         String
  size             Int
  pageCount        Int?

  status           String   @default("queued")
  /// User-facing failure sentence, chosen from lib/workflows/failure.ts. Never
  /// a raw thrown message: those can carry internal detail, and a parser error
  /// is not guaranteed to be free of document content.
  error            String?
  /// Why it failed, as a stable code. Retry decisions read this rather than
  /// re-parsing the sentence shown to the user.
  errorCode        String?

  /// Set once the client upload has been ingested and re-sealed by the
  /// pipeline. Null while the browser is still uploading.
  sourceBlobKey    String?
  /// Plaintext client-upload landing spot, deleted as soon as ingest re-seals it.
  uploadBlobKey    String?
  processedBlobKey String?
  /// Durable run that is processing (or last processed) this document.
  workflowRunId    String?
  /// Wrapped per-document data key (base64), unwrapped server-side only.
  encryptionKey    String?
  checksum         String?
  processedChecksum String?

  /// Hashed owner identity; a document belongs to this and nothing else.
  userFingerprint  String
  /// Hashed quota bucket (session + coarse network), charged after extraction
  /// when the real page or cell count is known.
  quotaKey         String?
  /// Encrypted normalized-model artifact. Extracted text never sits in the
  /// database in the clear.
  normalizedBlobKey String?
  metadata         Json?

  redactions       Redaction[]
  rules            GlobalRule[]
  events           ProcessingEvent[]
  exports          ExportArtifact[]

  @@index([userFingerprint])
  @@index([expiresAt])
}

model Redaction {
  id          String   @id
  documentId  String
  createdAt   DateTime @default(now())

  source      String
  type        String
  category    String
  confidence  Float?
  status      String   @default("suggested")

  page        Int?
  text        String?
  startOffset Int?
  endOffset   Int?

  worksheet   String?
  row         Int?
  column      Int?

  reason      String?
  ruleId      String?
  metadata    Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, status])
}

model GlobalRule {
  id                String   @id
  documentId        String
  createdAt         DateTime @default(now())

  pattern           String
  normalizedPattern String
  category          String
  enabled           Boolean  @default(true)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ProcessingEvent {
  id         String   @id
  documentId String
  at         DateTime @default(now())
  type       String
  payload    Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, at])
}

/// A generated export. Kept encrypted, addressed only by signed token.
model ExportArtifact {
  id                String   @id
  documentId        String
  createdAt         DateTime @default(now())
  blobKey           String
  checksum          String
  mimeType          String
  extension         String
  size              Int
  appliedRedactions Int      @default(0)
  metadataSanitized Boolean  @default(false)
  labelsAdded       Boolean  @default(false)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

/// Per-fingerprint daily quota accounting. Enforced server-side only.
model UsageRecord {
  id          String   @id
  fingerprint String
  date        DateTime @db.Date
  pdfPages    Int      @default(0)
  xlsxCells   Int      @default(0)
  images      Int      @default(0)
  docxPages   Int      @default(0)
  uploads     Int      @default(0)

  @@unique([fingerprint, date])
}

/// AI cost/telemetry per processing job. Never stores document content.
model AiUsage {
  id           String   @id
  documentId   String
  createdAt    DateTime @default(now())
  task         String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  chunks       Int      @default(1)

  @@index([documentId])
}

/// Runtime settings that survive a restart and can be changed without editing
/// source or redeploying — the rate-limit CLI writes here.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Token-bucket rate limiting, keyed by hashed network/session identifiers.
/// A bucket refills continuously, so there is no window boundary to burst
/// across the way a fixed window allows.
model RateLimit {
  key       String   @id
  tokens    Float
  updatedAt DateTime

  @@index([updatedAt])
}
