generator client {
  provider = "prisma-client"
  output   = "../lib/database/generated"
}

datasource db {
  provider = "postgresql"
}

/// An uploaded source document. The stored source bytes are AES-256-GCM
/// encrypted; `checksum` is a SHA-256 integrity hash, never a key.
model Document {
  id               String   @id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  expiresAt        DateTime
  ttlSeconds       Int      @default(86400)

  originalName     String
  kind             String
  mimeType         String
  size             Int
  pageCount        Int?

  status           String   @default("queued")
  /// Which named detector set the analysis ran with. Null means everything was
  /// looked for, which is the default: a missing preset must never narrow the
  /// sweep. See lib/redaction/presets.ts.
  preset           String?

  /// User-facing failure sentence, chosen from lib/workflows/failure.ts. Never
  /// a raw thrown message: those can carry internal detail, and a parser error
  /// is not guaranteed to be free of document content.
  error            String?
  /// Why it failed, as a stable code. Retry decisions read this rather than
  /// re-parsing the sentence shown to the user.
  errorCode        String?

  /// Set once the client upload has been ingested and re-sealed by the
  /// pipeline. Null while the browser is still uploading.
  sourceBlobKey    String?
  /// Client-upload landing spot, deleted as soon as ingest re-seals it. The
  /// object is ciphertext when `uploadFormat` is set, and plaintext otherwise.
  uploadBlobKey    String?
  /// The single-use key the browser sealed its upload with, wrapped under the
  /// master key (base64). Minted at reservation, returned to the browser once,
  /// nulled at ingest. Never the document's data key. See
  /// lib/storage/upload-encryption.ts.
  uploadEncryptionKey String?
  /// Which envelope the upload was sealed in: `v1`, or null for a plaintext
  /// upload. Ingest dispatches on this, never on the bytes.
  uploadFormat     String?
  processedBlobKey String?
  /// Durable run that is processing (or last processed) this document.
  workflowRunId    String?
  /// Wrapped per-document data key (base64), unwrapped server-side only.
  encryptionKey    String?
  /// Which envelope this document's objects are sealed in: null or `v0` for the
  /// original whole-object AES-256-GCM, `v1` for the chunked format. Every
  /// object the document owns shares it, and reads dispatch on this rather
  /// than on the bytes. See lib/storage/sealed.ts.
  encryptionFormat String?
  checksum         String?
  processedChecksum String?

  /// The upload this document arrived in, when it arrived with others. A batch
  /// carries review decisions across its documents; it never couples their
  /// processing, so one failing leaves the rest alone.
  batchId          String?

  /// The message this document was pulled out of, when it arrived as an
  /// attachment rather than off a desktop. Provenance only: a child is a
  /// first-class document with its own run, its own quota accounting and its
  /// own failure, and nothing downstream branches on this being set.
  parentDocumentId String?
  /// The MIME part the bytes came from, as a dotted path (`0.3`). The part
  /// path rather than the filename, because filenames collide, filenames get
  /// redacted, and only the path is actually unique and actually stable.
  sourcePartPath   String?

  /// Hashed owner identity; a document belongs to this and nothing else.
  userFingerprint  String
  /// Hashed quota bucket (session + coarse network), charged after extraction
  /// when the real page or cell count is known.
  quotaKey         String?
  /// Encrypted normalized-model artifact. Extracted text never sits in the
  /// database in the clear.
  normalizedBlobKey String?
  /// Where each page sits in the normalized model's JSON: byte offsets and
  /// page numbers, never content. Lets a reader take one page by a ranged read
  /// instead of the whole model. Null for a model written before it existed,
  /// which is read whole. See lib/documents/normalized-json.ts.
  normalizedIndex  Json?
  metadata         Json?

  redactions       Redaction[]
  rules            GlobalRule[]
  events           ProcessingEvent[]
  exports          ExportArtifact[]
  documentExports  DocumentExport[]
  batch            Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  parent           Document?         @relation("Attachments", fields: [parentDocumentId], references: [id], onDelete: Cascade)
  attachments      Document[]        @relation("Attachments")

  @@index([userFingerprint])
  @@index([expiresAt])
  @@index([batchId])
  @@index([parentDocumentId])
  /// The admission queue: queued documents with no workflow run, oldest first
  /// per owner (#171). Partial in the database (WHERE status = 'queued' AND
  /// "workflowRunId" IS NULL), which this schema cannot say; see the migration
  /// 20261006120000_add_admission_queue_index.
  @@index([userFingerprint, createdAt], map: "Document_admission_queue_idx")
  /// Documents a run is working on, by last change (#181, #182): counted by
  /// the global admission cap, and searched by the lost-worker sweep. Partial
  /// in the database; see the migration 20261010120000_add_in_flight_index.
  @@index([updatedAt], map: "Document_in_flight_idx")
  /// One child per part, enforced by the database rather than by the step that
  /// writes it. Expansion is retried like every other step and re-parses the
  /// message from scratch; this is what makes a second pass unable to produce
  /// a second copy of the same attachment.
  @@unique([parentDocumentId, sourcePartPath])
}

/// Documents uploaded and reviewed as one pass.
///
/// A batch owns decisions, not documents: each document keeps its own run, its
/// own quota accounting and its own failure, and the batch is only what makes a
/// decision taken in one of them apply to the others.
model Batch {
  id              String   @id
  createdAt       DateTime @default(now())
  userFingerprint String

  documents       Document[]
  rules           BatchRule[]
  exports         BatchExport[]

  @@index([userFingerprint])
}

/// A durable run that exports every document in a batch.
///
/// The run is the record. A batch export is minutes of work that outlives the
/// request that asked for it — the browser can be closed, the function that
/// started it can be recycled — so its progress lives here rather than in the
/// response stream, and any later reader can say exactly where it got to.
model BatchExport {
  id              String   @id
  batchId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// queued | running | ready | failed | cancelled
  status          String   @default("queued")
  /// The durable run doing the work.
  workflowRunId   String?

  total           Int      @default(0)
  /// Documents settled either way, so progress is honest about skips.
  completed       Int      @default(0)
  exported        Int      @default(0)

  /// One entry per document: its name, its state and why it was skipped. Names
  /// only — nothing about what was found in any of them.
  documents       Json?

  /// Export options the run was started with.
  options         Json?
  /// Hashed network bucket, so each document is charged the export allowance
  /// it would have been charged on its own.
  networkKey      String?

  /// Set by the reviewer; the run stops at the next document boundary.
  cancelRequested Boolean  @default(false)
  /// User-facing sentence. Never a raw thrown message.
  error           String?

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([batchId, status])
}

/// A decision carried across a batch: "this value is a subject wherever it
/// appears in these files". It is materialized into a per-document GlobalRule
/// for every document in the batch, including ones that finish processing
/// after the decision was made.
model BatchRule {
  id                String   @id
  batchId           String
  createdAt         DateTime @default(now())

  pattern           String
  normalizedPattern String
  /// `literal` or `regex`. Literal is what every rule before RegEx rules was.
  kind              String   @default("literal")
  matchCase         Boolean  @default(false)
  wholeWord         Boolean  @default(false)
  category          String
  /// Switched off, the decision stays listed but reaches no document: its
  /// copies lose their redactions, and documents that finish later skip it.
  enabled           Boolean  @default(true)
  /// Where the reviewer made the decision, so the interface can say so.
  originDocumentId  String?

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model Redaction {
  id          String   @id
  documentId  String
  createdAt   DateTime @default(now())

  source      String
  type        String
  category    String
  confidence  Float?
  status      String   @default("suggested")
  /// What accepting this does to the bytes. Null means mask, which is what
  /// every redaction taken before methods existed did. See
  /// lib/redaction/methods.ts for which categories permit which.
  method      String?

  page        Int?
  text        String?
  startOffset Int?
  endOffset   Int?

  worksheet   String?
  row         Int?
  column      Int?

  reason      String?
  ruleId      String?
  metadata    Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, status])
}

model GlobalRule {
  id                String   @id
  documentId        String
  createdAt         DateTime @default(now())

  pattern           String
  normalizedPattern String
  /// `literal` or `regex`; see lib/redaction/patterns.ts.
  kind              String   @default("literal")
  matchCase         Boolean  @default(false)
  wholeWord         Boolean  @default(false)
  category          String
  enabled           Boolean  @default(true)
  /// Set when this rule is one document's copy of a batch-wide decision.
  batchRuleId       String?
  /// Set when this rule is one document's copy of an owner's global rule.
  ownerRuleId       String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([batchRuleId])
  @@index([ownerRuleId])
}

/// A decision that outlives the documents it was made in: "redact this in
/// everything I upload". The interface calls these global rules.
///
/// It belongs to the anonymous owner — the session cookie — like a document
/// does, and it is applied at the end of processing to every document that
/// owner uploads afterwards, the way a batch rule is carried into a document
/// that finished late.
///
/// Unlike every other rule it is not deleted with a document, so the pattern
/// is document content kept for longer than any document is. It is therefore
/// sealed under the master key rather than stored in the clear, and it expires
/// once it has gone unused for as long as the session cookie lives: a rule
/// nobody can reach any more is a secret kept for nobody. Export and import
/// are how a team keeps a rule set beyond that.
model OwnerRule {
  id               String   @id
  userFingerprint  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// Moved forward whenever the rule is applied, edited or switched on.
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime

  kind             String   @default("literal")
  /// The pattern, sealed with the master key (base64). Never stored in the
  /// clear: see lib/redaction/owner-rules.ts.
  sealedPattern    String
  matchCase        Boolean  @default(false)
  wholeWord        Boolean  @default(false)
  category         String
  enabled          Boolean  @default(true)
  /// Where the reviewer made the decision, while that document still exists.
  originDocumentId String?

  @@index([userFingerprint])
  @@index([expiresAt])
}

model ProcessingEvent {
  id         String   @id
  documentId String
  at         DateTime @default(now())
  type       String
  payload    Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, at])
}

/// A generated export. Kept encrypted, addressed only by signed token.
model ExportArtifact {
  id                String   @id
  documentId        String
  createdAt         DateTime @default(now())
  blobKey           String
  checksum          String
  mimeType          String
  extension         String
  size              Int
  appliedRedactions Int      @default(0)
  metadataSanitized Boolean  @default(false)
  labelsAdded       Boolean  @default(false)
  /// Which output of one review this is, when the reviewer asked for more than
  /// one. Null for artifacts exported before variants existed, which is the
  /// same thing as "redacted". See lib/redaction/variants.ts.
  variant           String?
  /// The export report generated with this artifact: counts, styles and both
  /// checksums, stored encrypted beside the file it describes. Null for
  /// artifacts exported before reports existed.
  reportBlobKey     String?
  reportChecksum    String?
  /// The token vault for this artifact, when a batch produced one.
  ///
  /// Only ever written by a batch export. A single-document export hands its
  /// vault straight back in the response and stores nothing, which is what
  /// makes an `encrypt` export unreversible by this tool — a batch has no
  /// response to hand it back in, so it is sealed under the same per-document
  /// key as the artifact and dies with the document. During that window the
  /// source itself is already in the same bucket under the same key, so this
  /// adds no capability that was not already there.
  vaultBlobKey      String?
  vaultChecksum     String?
  /// True when the stored vault is sealed to the requesting browser's key
  /// rather than the document's (#187): an envelope Anonify cannot open,
  /// deleted once it has been fetched. See docs/security-internals.md §11.
  vaultRecipient    Boolean  @default(false)
  /// The single export that produced this artifact, when one did (#187).
  /// A retried step overwrites its own row: one per (export, variant).
  exportId          String?

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  export   DocumentExport? @relation(fields: [exportId], references: [id], onDelete: SetNull)

  @@unique([exportId, variant])
  @@index([documentId])
}

/// One request to export one document, run in the background on a worker
/// (#187). The batch export's single-document sibling: the route records it
/// and starts the run, the run writes progress and artifacts here, and the
/// dialog reads it back however often it is closed and reopened.
model DocumentExport {
  id                String   @id
  documentId        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// queued | running | ready | failed | cancelled
  status            String   @default("queued")
  /// The durable run doing the work.
  workflowRunId     String?

  /// The variants asked for, as the route parsed them (lib/redaction/variants.ts).
  variants          Json
  metadataSanitized Boolean  @default(true)
  /// The requester's ECDH P-256 public key, raw and base64url. A vault is
  /// sealed to it and to nothing Anonify holds. Null only on the deprecated
  /// synchronous path, which seals to a key that lives in the request.
  recipientKey      String?

  /// Where the run has got to: a stage, a variant, a page of a total. Never
  /// anything from the document.
  progress          Json?
  /// Set by the reviewer; the run stops before its next variant.
  cancelRequested   Boolean  @default(false)
  /// User-facing sentence. Never a raw thrown message.
  error             String?

  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  artifacts ExportArtifact[]

  @@index([documentId, createdAt])
}

/// Per-fingerprint daily quota accounting. Enforced server-side only.
model UsageRecord {
  id          String   @id
  fingerprint String
  date        DateTime @db.Date
  pdfPages    Int      @default(0)
  /// Filled cells across every grid format: XLSX, CSV and TSV.
  xlsxCells   Int      @default(0)
  images      Int      @default(0)
  docxPages   Int      @default(0)
  /// Pages of extracted text, for plain text and RTF.
  textPages   Int      @default(0)
  /// Kibibytes of decoded text pulled out of a message: headers, every text
  /// part and every nested message. An email is not a page.
  emailKilobytes Int   @default(0)
  /// Slides in a deck. Notes, layouts and masters are processed with the slide
  /// they belong to rather than charged separately.
  pptxSlides  Int      @default(0)
  uploads     Int      @default(0)
  /// Model tokens, input and output, spent by Hush on this identity's behalf.
  assistantTokens Int  @default(0)

  @@unique([fingerprint, date])
}

/// AI cost/telemetry per processing job. Never stores document content.
model AiUsage {
  id           String   @id
  documentId   String
  createdAt    DateTime @default(now())
  task         String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  chunks       Int      @default(1)

  @@index([documentId])
}

/// Runtime settings that survive a restart and can be changed without editing
/// source or redeploying — the rate-limit CLI writes here.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Token-bucket rate limiting, keyed by hashed network/session identifiers.
/// A bucket refills continuously, so there is no window boundary to burst
/// across the way a fixed window allows.
model RateLimit {
  key       String   @id
  tokens    Float
  updatedAt DateTime

  @@index([updatedAt])
}

/// A slot in a cluster-wide concurrency limit on an outbound service (#184),
/// with ANONIFY_SERVICE_LIMIT_SCOPE=cluster. `key` is the service
/// (`svc:ai:lease`), and a limit of N is slots 0 to N-1, so the primary key is
/// what stops two replicas holding the same one. A slot whose lease has
/// expired is free, and the next acquire overwrites it: a worker that crashed
/// mid-request gives its slots back without anyone deleting anything.
model ServiceLease {
  key       String
  slot      Int
  id        String
  expiresAt DateTime @db.Timestamptz(3)

  @@id([key, slot])
}
